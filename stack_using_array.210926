#include<stdio.h>
#define size 5;
int stack[5];
int top=-1;
void push(int x){
    if(top==5-1){
        printf("stack overflow");
    }else{
        top = top + 1;
        stack[top]=x;
    }
}
    void pop(){
        if(top==-1){
            printf("Under flow");
        }
        else{
            printf("Deleted elements is %d\n",stack[top]);
            top =top-1;
        }
    }
    void main(){
        push(10);
        push(45);
        push(4);
        push(47);
        pop();
        pop();
        push(85);
        pop();
        pop();
        push(56);
    }
  

    
