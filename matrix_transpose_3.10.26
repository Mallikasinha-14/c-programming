#include<stdio.h>

int main(){

    int arr[10][10], trans[10][10];
    int r,c;

    printf("Enter rows and columns: ");
    scanf("%d %d",&r,&c);

    printf("Enter elements of matrix:\n");

    for(int i=0; i<r; i++){
        for(int j=0; j<c; j++){
            scanf("%d",&arr[i][j]);
        }
    }


    for(int i=0; i<r; i++){
        for(int j=0; j<c; j++){
            trans[j][i] = arr[i][j];
        }
    }

    printf("Transpose of matrix:\n");

    for(int i=0; i<c; i++){
        for(int j=0; j<r; j++){
            printf("%d ",trans[i][j]);
        }
        printf("\n");
    }

    return 0;
}
