#include<stdio.h>
#include<stdlib.h>
struct node
{
    int data;
    struct node *next;
};
struct node *new,*top,*t;
void push(int x)
{
    new = (struct node*)malloc(sizeof(struct node));
    new->data=x;
    new->next = top;
    top = new;
}
void pop(){
    if(top==NULL){
        printf("stack underflow");

    }
    else{
        t=top;
        top = top->next;
        printf("Deleted elements is %d\n",t->data);
        free(t);
        t= NULL;
    }
    }
    void main(){
        top = NULL;
        push(4);
        push(45);
        push(6);
        push(2);
        pop();
        pop();
        push(65);
    
}
