#include<stdio.h>
int main(){
    int arr1[10][10],arr2[10][10],mul[10][10];
    int r1,c1,r2,c2;
    int i,j;
    printf("Enter no. elements in row and column of arr1");
    scanf("%d %d",&r1,&c1);
  
    printf("Enter elements of first matrix:\n");
    for(int i = 0; i < r1; i++) {
        for(int j = 0; j < c1; j++) {
            scanf("%d", &arr1[i][j]);
        }
    }
    printf("Enter no. elements in row and column of arr2");
    scanf("%d %d",&r2,&c2);
  
    printf("Enter elements of second matrix:\n");
    for(int i = 0; i < r2; i++) {
        for(int j = 0; j < c2; j++) {
            scanf("%d", &arr2[i][j]);
        }
    }
    for(int i=0;i<r1;i++){
        for(int j=0;j<c2;j++){
            mul[i][j]=0;
            for(int k=0;k<c1;k++){
            mul[i][j]=mul[i][j]+arr1[i][k]*arr2[k][j];
        }
    }
    }
  printf("Multiplication of matrices:\n");

    for(int i=0; i<r1; i++){
        for(int j=0; j<c2; j++){
            printf("%d ",mul[i][j]);
        }
        printf("\n");
    }

    return 0;
}
            
