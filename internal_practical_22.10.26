#include<stdio.h>
int main(){
    int n,ele,pos,i;
    int a[100];
    printf("Enter no. of elements");
    scanf("%d",&n);
    for(int i=0;i<n;i++){
        scanf("%d",&a[i]);
    }
    for(int i=0;i<n;i++){
        printf("%d",a[i]);
    }
    printf("Enter element to insert");
    scanf("%d",&ele);
    printf("enter pos");
    scanf("%d",&pos);
    for(int i=n;i>=pos;i--){
        a[i]=a[i-1];
    }
    a[pos-1]=ele;
    n++;
    printf("enter position to delete");
    scanf("%d",&pos);
    for(int i=pos-1;i<n-1;i++){
        a[i]=a[i+1];
    }
    n--;
    for(int i=0;i<n;i++){
        printf("%d ", a[i]);
    }
}
